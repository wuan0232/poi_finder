# 本地默认使用 SQLite；部署到服务器时也可通过环境变量覆盖这些配置。
DATABASE_URL=sqlite:///./poi_finder.db
SQLITE_TIMEOUT=30
CACHE_TTL_HOURS=24

# 当前位置和周边检索使用高德 Web 服务 Key（不是前端 JS API Key）。
AMAP_KEY=

# 可选地图平台，仅用于普通城市关键词检索。
BAIDU_KEY=
TENCENT_KEY=

REQUEST_TIMEOUT=30
REQUEST_INTERVAL=0.25
MAX_RETRIES=3

# 对地图结果中已有的机构官网进行公开联系方式补全。
WEBSITE_ENRICHMENT_ENABLED=true
WEBSITE_MAX_PAGES=3
WEBSITE_MAX_BYTES=1000000
WEBSITE_REQUEST_INTERVAL=0.5
